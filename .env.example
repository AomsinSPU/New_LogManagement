# Copy to .env and set a strong local password before starting Compose.
POSTGRES_DB=logmanagement
POSTGRES_USER=logmanagement_admin
POSTGRES_PASSWORD=

# Backend: loads this root .env without overriding system environment variables.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=5432
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
# DATABASE_URL takes precedence over the separate PostgreSQL fields.
# Leave blank for local Docker. Do not include SSL query parameters in this URL.
DATABASE_URL=
# Use true for connections requiring TLS with a trusted server certificate.
DB_SSL=false

# Simulator HTTP secret; never commit a real key. UDP mode uses the collector's key.
SIMULATOR_INGEST_KEY=
